{
  "name": "@nlr/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ESLint, TypeScript and Tailwind config + No Limits Removalists brand tokens and company constants.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./brand": "./src/brand.ts",
    "./eslint/base": "./eslint/base.mjs",
    "./eslint/react": "./eslint/react.mjs",
    "./eslint/next": "./eslint/next.mjs",
    "./typescript/base": "./typescript/base.json",
    "./typescript/library": "./typescript/library.json",
    "./typescript/nextjs": "./typescript/nextjs.json",
    "./tailwind/theme.css": "./tailwind/theme.css"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.61.0"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "typescript": "^5.9.3"
  }
}
