# ──────────────────────────────────────────────────────────────────────────
# Environment variables for this app.
#
# Convention (see docs/CONVENTIONS.md):
#   - This file is COMMITTED and documents every var the app reads, with safe
#     example values. Update it whenever you add a var.
#   - Real secrets live ONLY in Vercel env vars (and your local .env, which
#     is gitignored). Never commit a real key.
#   - NEXT_PUBLIC_* vars are sent to the browser — no secrets in them, ever.
# ──────────────────────────────────────────────────────────────────────────

# Canonical URL of this deployment — used for SEO metadata.
# Locally this can stay unset; set it in Vercel per environment.
NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# Movepro adapter (see packages/movepro). Mock is the default and works with
# no credentials. Only flip to "live" once API access is confirmed (TODO.md).
MOVEPRO_MODE=mock
MOVEPRO_API_KEY=
MOVEPRO_BASE_URL=
