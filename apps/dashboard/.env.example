# ──────────────────────────────────────────────────────────────────────────
# Environment variables for this app.
#
# Convention (see docs/CONVENTIONS.md):
#   - This file is COMMITTED and documents every var the app reads, with safe
#     example values. Update it whenever you add a var.
#   - Real secrets live ONLY in Vercel env vars (and your local .env, which
#     is gitignored). Never commit a real key.
#   - NEXT_PUBLIC_* vars are sent to the browser — no secrets in them, ever.
# ──────────────────────────────────────────────────────────────────────────

# Canonical URL of this deployment — used for SEO metadata.
# Locally this can stay unset; set it in Vercel per environment.
NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# Movepro adapter (see packages/movepro). Mock is the default and works with
# no credentials. Only flip to "live" once API access is confirmed (TODO.md).
MOVEPRO_MODE=mock
MOVEPRO_API_KEY=
MOVEPRO_BASE_URL=

# ── /actions rep activity board ─────────────────────────────────────────────
# Bearer token for MovePro's Metabase-embedded activity report (calls/emails/
# messages per sales agent), used by src/lib/movepro-actions.ts. This is a
# SEPARATE MovePro integration from packages/movepro above — different API
# (api.movepro.com.au + movepro.metabaseapp.com), different token. Set in
# Vercel env vars (all environments); never commit the real value.
MOVEPRO_TOKEN=

# ── Google Sheets sync ──────────────────────────────────────────────────────
# Used by `pnpm db:sync-sheet` and the api/cron/sync-sheet route to pull the
# floor roster (names, intake weights, daily goals) from the company
# "Leaderboard" tab into the database. None of these are needed to run the app;
# only to refresh roster data from the sheet.
#
# Auth is a USER OAuth refresh token, not a service account — the company
# Google org blocks service-account keys (iam.managed.disableServiceAccount
# ApiKeyCreation). Put the authorized-user OAuth JSON on ONE line here. It must
# contain client_id, client_secret and refresh_token (the file produced by the
# one-time consent flow already has them). NEVER commit the real value — set it
# in your local .env and in Vercel env vars.
# ⚠ While the OAuth app is in "Testing" mode this refresh token expires ~7 days
#   after it is minted; see TODO.md before relying on the scheduled cron.
GOOGLE_SHEETS_TOKEN_JSON={"client_id":"…","client_secret":"…","refresh_token":"…"}

# The spreadsheet holding the "Leaderboard" tab (the company "Follow-Up" sheet).
NLR_LEADERBOARD_SPREADSHEET_ID=your-spreadsheet-id

# Optional — override the A1 range read for the rep roster (default shown).
NLR_LEADERBOARD_RANGE=Leaderboard!A5:C40

# Shared bearer secret protecting the api/cron/* routes from public calls.
# Set the same value in Vercel; cron invocations send it as `Bearer <secret>`.
CRON_SECRET=

# Live push from the spreadsheet's Apps Script (POST /api/ingest/leaderboard).
# Long random value; set the SAME value here, in Vercel, and in the Apps Script
# Script properties (scripts/sheets/README.md). If unset, the ingest route is
# disabled (503).
INGEST_SECRET=
